# ==========================================
# DEPENDENCIAS
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# COMPILACIÓN Y PRODUCCIÓN
# ==========================================
dist/
build/
.next/
out/
*.tsbuildinfo
*.buildinfo
.eslintcache
.parcel-cache

# ==========================================
# VARIABLES DE ENTORNO Y SECRETOS
# ==========================================
# Ignorar todos los archivos de entorno
.env
.env.*
# Permitir únicamente plantillas de ejemplo
!.env.example
!*.env.example
!**/.env.example
!**/.env.*.example

# Credenciales y archivos sensibles
credentials.json
secrets.json
*.secret
*.secrets
**/secrets/
**/credentials/
.htpasswd
.netrc
.pgpass
.my.cnf
.npmrc
.pypirc

# Claves privadas, certificados y configuraciones SSH
*.ppk
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_dsa
id_dsa.pub
*.crt
*.cer
docker/nginx/ssl/*.crt
docker/nginx/ssl/*.key
docker/nginx/ssl/*.pem
!docker/nginx/ssl/.gitkeep
ssh_config
config.ssh

# ==========================================
# UPLOADS Y ARCHIVOS DE USUARIOS
# ==========================================
apps/backend/uploads/**/*
!apps/backend/uploads/**/.gitkeep
storage/**/*
!storage/**/.gitkeep

# ==========================================
# BASE DE DATOS Y BACKUPS
# ==========================================
*.dump
*.backup
*.bak
*.sql.gz
*.sql.tar
*.sql.tar.gz
backups/
backup/
# Ignorar archivos SQL ad-hoc en la raíz, permitiendo solo database/ y scripts/
*.sql
!database/**/*.sql
!scripts/**/*.sql

# Prisma
prisma/migrations/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ==========================================
# ARCHIVOS BINARIOS Y DISEÑOS PESADOS
# ==========================================
*.pbix
*.pbit

# ==========================================
# TESTING Y COBERTURA
# ==========================================
coverage/
*.lcov

# ==========================================
# LOGS
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==========================================
# HERRAMIENTAS, IDEs Y AGENTES
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.agents/
.antigravity/
*.swp
*.swo
*~
.docker/
.cache/
.turbo/

# ==========================================
# ARCHIVOS TEMPORALES Y SISTEMA OPERATIVO
# ==========================================
*.tmp
*.temp
tmp/
temp/
.DS_Store
Thumbs.db
