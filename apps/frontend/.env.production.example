# Frontend Production Environment Variables (Plantilla de Ejemplo)
# Copiar a .env.production y ajustar las URLs correspondientes

# API URL - Producción (nginx proxy o IP de servidor)
VITE_API_URL=http://apps.movingenia.com/api

# WebSocket URL - Producción (nginx proxy con soporte WebSocket o IP de servidor)
VITE_WS_URL=http://apps.movingenia.com
